{
  "name": "settle-ui-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/settle-ui",
    "playground"
  ],
  "scripts": {
    "dev": "npm run dev -w playground",
    "build": "npm run build -w settle-ui && npm run build -w playground",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
