{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "settle-ui": ["packages/settle-ui/src/index.ts"]
    }
  },
  "include": [
    "packages/settle-ui/src",
    "packages/settle-ui/vite.config.ts",
    "playground/src",
    "playground/e2e",
    "playground/vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
